{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["**/*.{ts,tsx}"]
    },
    "//#lint": {},
    "//#lint:check": {},
    "//#format": {},
    "//#format:check": {},
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["**/*.{ts,tsx}"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "coverage": {
      "dependsOn": ["^coverage"],
      "cache": false
    }
  }
}
