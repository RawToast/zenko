{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "codegen": {
      "outputs": ["src/**/*.gen.ts"],
      "inputs": [
        "**/*.yaml",
        "../specs/**/*.yaml",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/build/**",
        "generate.js"
      ],
      "cache": true
    },
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["**/*.{ts,tsx}"]
    },
    "//#lint": {},
    "//#lint:check": {},
    "//#format": {},
    "//#format:check": {},
    "check-types": {
      "dependsOn": ["codegen", "^check-types"],
      "inputs": [
        "**/*.{ts,tsx}",
        "**/*.gen.ts",
        "**/*.yaml",
        "../specs/**/*.yaml"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "**/*.yaml",
        "../specs/**/*.yaml"
      ],
      "dependsOn": ["^test"]
    },
    "coverage": {
      "dependsOn": ["^coverage"],
      "cache": false
    }
  }
}
