  metric: z.string().optional(),
  value: z.number().optional(),
})),
});

export type Report = z.infer<typeof Report>;

// Path Functions
export const paths = {
  exportUsersCsv: ({ format }: { format?: string } = {}) => {
    const params = new URLSearchParams()
    if (format !== undefined) {
      params.set("format", String(format))
    }
    const _searchParams = params.toString()
    return \`/export/users\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  exportDataXml: () => "/export/data",
  downloadFile: ({ fileId }: { fileId: string }) => \`/download/\${fileId}\`,
  getDocumentPdf: ({ documentId }: { documentId: string }) => \`/documents/\${documentId}/pdf\`,
  getImage: ({ imageId, size }: { imageId: string, size?: string }) => {
    const params = new URLSearchParams()
    if (size !== undefined) {
      params.set("size", String(size))
    }
    const _searchParams = params.toString()
    return \`/images/\${imageId}\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  getLogs: ({ lines, level }: { lines?: number, level?: string } = {}) => {
    const params = new URLSearchParams()
    if (lines !== undefined) {
      params.set("lines", String(lines))
    }
    if (level !== undefined) {
      params.set("level", String(level))
    }
    const _searchParams = params.toString()
    return \`/logs\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  streamEvents: () => "/stream/events",
  getReport: ({ reportId, format }: { reportId: string, format?: string }) => {
    const params = new URLSearchParams()
    if (format !== undefined) {
      params.set("format", String(format))
    }
    const _searchParams = params.toString()
    return \`/reports/\${reportId}\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  getHealthText: () => "/api/health",
  downloadArchive: ({ archiveId }: { archiveId: string }) => \`/download/zip/\${archiveId}\`,
  getMarkdownDoc: ({ docId }: { docId: string }) => \`/markdown/\${docId}\`,
