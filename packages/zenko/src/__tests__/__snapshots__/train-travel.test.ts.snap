});

export type WrapperCollection = z.infer<typeof WrapperCollection>;

export const BookingPayment = z.object({
  id: z.string().uuid().optional(),
  amount: z.number().optional(),
  currency: z.enum(["bam", "bgn", "chf", "eur", "gbp", "nok", "sek", "try"]).optional(),
  source: z.object({}).optional(),
  status: z.enum(["pending", "succeeded", "failed"]).optional(),
});

export type BookingPayment = z.infer<typeof BookingPayment>;

export const LinksBooking = z.object({
  booking: z.string().url().optional(),
});

