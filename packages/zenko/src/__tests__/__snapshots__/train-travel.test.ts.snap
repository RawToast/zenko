// Path Functions
export const paths = {
  getStations: ({ page, limit, coordinates, search, country }: { page?: number, limit?: number, coordinates?: string, search?: string, country?: string } = {}) => {
    const params = new URLSearchParams()
    if (page !== undefined) {
      params.set("page", String(page))
    }
    if (limit !== undefined) {
      params.set("limit", String(limit))
    }
    if (coordinates !== undefined) {
      params.set("coordinates", String(coordinates))
    }
    if (search !== undefined) {
      params.set("search", String(search))
    }
    if (country !== undefined) {
      params.set("country", String(country))
    }
    const _searchParams = params.toString()
    return \`/stations\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  getTrips: ({ page, limit, origin, destination, date, bicycles, dogs }: { page?: number, limit?: number, origin: string, destination: string, date: string, bicycles?: boolean, dogs?: boolean }) => {
    const params = new URLSearchParams()
    if (page !== undefined) {
      params.set("page", String(page))
    }
    if (limit !== undefined) {
      params.set("limit", String(limit))
    }
    params.set("origin", String(origin))
    params.set("destination", String(destination))
    params.set("date", String(date))
    if (bicycles !== undefined) {
      params.set("bicycles", bicycles ? "true" : "false")
    }
    if (dogs !== undefined) {
      params.set("dogs", dogs ? "true" : "false")
    }
    const _searchParams = params.toString()
    return \`/trips\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  getBookings: ({ page, limit }: { page?: number, limit?: number } = {}) => {
    const params = new URLSearchParams()
    if (page !== undefined) {
      params.set("page", String(page))
    }
    if (limit !== undefined) {
      params.set("limit", String(limit))
    }
    const _searchParams = params.toString()
    return \`/bookings\${_searchParams ? \`?\${_searchParams}\` : ""}\`
  },
  createBooking: () => "/bookings",
  getBooking: ({ bookingId }: { bookingId: string }) => \`/bookings/\${bookingId}\`,
  deleteBooking: ({ bookingId }: { bookingId: string }) => \`/bookings/\${bookingId}\`,
  createBookingPayment: ({ bookingId }: { bookingId: string }) => \`/bookings/\${bookingId}/payment\`,
} as const;

