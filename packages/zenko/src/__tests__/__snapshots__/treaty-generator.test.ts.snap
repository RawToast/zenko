    operations,
    operationMetadata,
    options: { fetch: init?.fetch },
  })
  const routes = createTreatyClient({
    baseUrl,
    routes: treatyRoutes,
    fetch: init?.fetch,
  })
  return Object.assign(client, { $routes: routes })
}
"
