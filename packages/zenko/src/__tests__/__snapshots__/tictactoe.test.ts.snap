export const getSquare: GetSquareOperation = {
  method: "get",
  path: paths.getSquare,
  response: mark,
  errors: {
    clientErrors: {
      badRequest: errorMessage,
    },
  },
} as const;

export const putSquare: PutSquareOperation = {
  method: "put",
  path: paths.putSquare,
