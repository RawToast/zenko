{
  "name": "zenko",
  "version": "0.1.13",
  "description": "Generate TypeScript types and path functions from OpenAPI specs",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "zenko": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/zenko.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "bun": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RawToast/zenko.git"
  },
  "author": "RawToast",
  "license": "MIT",
  "keywords": [
    "openapi",
    "typescript",
    "codegen",
    "api",
    "generator",
    "swagger",
    "zod"
  ],
  "homepage": "https://github.com/RawToast/zenko#readme",
  "engines": {
    "bun": ">=1.2.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/RawToast/zenko/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "prepublishOnly": "bun run build",
    "check-types": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.2",
    "@typescript/native-preview": "7.0.0-dev.20251212.1",
    "tsup": "8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {}
}
