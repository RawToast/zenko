{
  "name": "zenko",
  "version": "0.1.15",
  "description": "Generate TypeScript types and path functions from OpenAPI specs",
  "keywords": [
    "api",
    "codegen",
    "generator",
    "openapi",
    "swagger",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/RawToast/zenko#readme",
  "bugs": {
    "url": "https://github.com/RawToast/zenko/issues"
  },
  "license": "MIT",
  "author": "RawToast",
  "repository": {
    "type": "git",
    "url": "https://github.com/RawToast/zenko.git"
  },
  "bin": {
    "zenko": "dist/cli.cjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*.cjs",
    "dist/**/*.d.cts",
    "dist/**/*.d.ts",
    "dist/**/*.mjs"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/zenko.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "bun": "./src/types.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "prepublishOnly": "bun run build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.3.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.22"
  }
}
