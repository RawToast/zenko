{
  "name": "zenko",
  "version": "0.1.1",
  "description": "Generate TypeScript types and path functions from OpenAPI specs",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "zenko": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RawToast/zenko.git"
  },
  "author": "RawToast",
  "license": "MIT",
  "keywords": [
    "openapi",
    "typescript",
    "codegen",
    "api",
    "generator",
    "swagger",
    "zod"
  ],
  "homepage": "https://github.com/RawToast/zenko#readme",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/RawToast/zenko/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "prepublishOnly": "bun run build",
    "format": "prettier --write '**/*'{js,ts,tsx,json} --experimental-cli",
    "format:check": "prettier --check '**/*'{js,ts,tsx,json} --experimental-cli",
    "lint": "oxlint src --fix --max-warnings=0",
    "lint:check": "oxlint src --fix --max-warnings=0",
    "check-types": "tsc --noEmit",
    "check": "turbo lint format check-types"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.0.4",
    "@types/bun": "1.3.0",
    "@types/js-yaml": "4.0.9",
    "oxlint": "1.11.2",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "zod": "4.1.12"
  },
  "packageManager": "bun@1.3.0"
}
