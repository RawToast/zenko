{
  "name": "@zenko/root",
  "private": true,
  "description": "Generate TypeScript types and path functions from OpenAPI specs",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint packages/*/src --fix --max-warnings=0",
    "lint:check": "oxlint packages/*/src --max-warnings=0",
    "check": "turbo lint format check-types",
    "dev": "turbo watch lint format check-types test",
    "zenko": "bun run --cwd packages/zenko",
    "nuke": "rimraf --glob '**/node_modules' --glob '**/dist' --glob '**/coverage' --glob 'packages/examples/**/*.gen.ts'"
  },
  "devDependencies": {
    "bun-scan": "1.1.0",
    "oxfmt": "0.24.0",
    "oxlint": "1.39.0",
    "rimraf": "6.1.2",
    "turbo": "2.7.4"
  },
  "engines": {
    "bun": ">=1.2.22"
  },
  "packageManager": "bun@1.3.5"
}
