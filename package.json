{
  "private": true,
  "packageManager": "bun@1.3.0",
  "description": "Generate TypeScript types and path functions from OpenAPI specs",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write '**/*'{js,ts,tsx,json,yaml} --experimental-cli",
    "format:check": "prettier --check '**/*'{js,ts,tsx,json,yaml} --experimental-cli",
    "lint": "oxlint packages/*/src --fix --max-warnings=0",
    "lint:check": "oxlint packages/*/src --max-warnings=0",
    "check": "turbo lint format check-types",
    "dev": "turbo watch lint format check-types test",
    "core": "bun run --cwd packages/zenko-core",
    "examples": "bun run --cwd packages/examples",
    "zenko": "bun run --cwd packages/zenko",
    "zenko-node": "bun run --cwd packages/zenko-node",
    "nuke": "rimraf --glob '**/node_modules' --glob '**/dist' --glob '**/coverage' --glob 'packages/examples/**/*.gen.ts'"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.0.4",
    "@socketsecurity/bun-security-scanner": "1.1.1",
    "oxlint": "1.26.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "turbo": "2.6.0",
    "typescript": "5.9.3"
  }
}
